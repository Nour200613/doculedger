# Backend Environment Variables Example
ENVIRONMENT=production
DEBUG=false
APP_NAME="DocuLedger B2B Parser API"

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_password@db.your_project.supabase.co:5432/postgres
SYNC_DATABASE_URL=postgresql://postgres:your_supabase_password@db.your_project.supabase.co:5432/postgres

# Redis (Upstash Serverless Redis)
REDIS_URL=rediss://default:your_upstash_password@your_upstash_endpoint:6379
CELERY_BROKER_URL=rediss://default:your_upstash_password@your_upstash_endpoint:6379

# Security
SECRET_KEY=generate_a_secure_64_character_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Stripe Payments
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
FRONTEND_URL=https://doculedger.vercel.app

# AI Engine Models
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
